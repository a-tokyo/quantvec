{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // rollup-plugin-dts (via tsup) injects a `baseUrl`, which TS 6 deprecates; silence it.
    "ignoreDeprecations": "6.0",

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    // The core is numeric, typed-array hot-loop code. noUncheckedIndexedAccess
    // would force `| undefined` on every TypedArray read and drown the kernels in
    // non-null assertions; we instead validate at boundaries (R8) and keep loops clean.
    "noUncheckedIndexedAccess": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Isomorphic core: do NOT auto-include any global @types (e.g. node globals).
    // Node-only code lives in src/node.ts and imports `node:*` modules explicitly.
    "types": [],

    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build", "assembly", "test", "benchmarks"]
}
